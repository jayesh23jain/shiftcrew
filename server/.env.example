NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shiftcrew
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
CLIENT_URL=http://localhost:5173
# Use "none" only when client and API are on different sites over HTTPS
COOKIE_SAMESITE=lax

# --- Phase 2-7 ---
# Secret for signing QR passes (defaults to a value derived from JWT_ACCESS_SECRET)
QR_SECRET=
# Used to encrypt UPI IDs at rest (min 16 chars). Defaults to a value derived from JWT_ACCESS_SECRET.
ENCRYPTION_KEY=
# mock = built-in sandbox checkout (no keys needed). razorpay = real Razorpay Orders in test/live mode.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Fee charged to the organizer on top of each payout
PLATFORM_FEE_PERCENT=2
# Optional. Without it, emails are printed to the server log.
SMTP_URL=
MAIL_FROM=ShiftCrew <no-reply@shiftcrew.test>
ENABLE_SCHEDULER=true

# --- Shared LLM Service (Free-Tier Friendly) ---
# Master switch for AI capabilities (true|false)
LLM_ENABLED=false

# Primary provider: "gemini" | "openai-compatible" | "mock"
# Tests automatically use "mock" and never call external APIs.
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your_gemini_api_key_here
# Never hardcode model names; free-tier model names change often. E.g. gemini-1.5-flash or gemini-2.0-flash
LLM_MODEL=gemini-1.5-flash

# Optional fallback provider invoked automatically on HTTP 429 or 5xx
# E.g. Groq free tier with llama-3.3-70b-versatile via openai-compatible adapter
LLM_FALLBACK_PROVIDER=openai-compatible
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=your_groq_api_key_here
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Global project-wide rate limiter (requests per minute) to prevent 429 quota exhaustion on free tiers
LLM_GLOBAL_RPM=10

# Daily token consumption budget cap across all features
LLM_DAILY_TOKEN_BUDGET=100000

# Privacy protection flag: whether personal or user identifiable data may ever be sent to LLMs (default false).
# Free LLM tiers may log or train on inputs, so keep this false unless explicit user consent is configured.
LLM_ALLOW_USER_DATA=false
